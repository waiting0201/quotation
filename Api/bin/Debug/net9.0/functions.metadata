[
  {
    "name": "Api",
    "scriptFile": "QuotationApi.dll",
    "entryPoint": "QuotationApi.Functions.ApiFunction.Run",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "req",
        "direction": "In",
        "type": "httpTrigger",
        "authLevel": "Anonymous",
        "methods": [
          "get",
          "post",
          "put",
          "delete",
          "options"
        ],
        "route": "api/{*route}",
        "properties": {}
      },
      {
        "name": "$return",
        "type": "http",
        "direction": "Out"
      }
    ]
  }
]